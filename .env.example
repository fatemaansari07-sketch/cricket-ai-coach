# Copy this file to .env and fill in your Supabase project values
# (Supabase dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-ONLY — used by api/cleanup-old-videos.js to delete week-old videos.
# NEVER prefix this with VITE_ (that would expose it to the browser).
# Supabase dashboard -> Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Any random long string — protects the cleanup endpoint from being called
# by randoms. Vercel Cron sends this automatically once you set it below.
CRON_SECRET=make-up-a-long-random-string
