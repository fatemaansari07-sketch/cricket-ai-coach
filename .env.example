VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side API routes (api/*.js) read these first, falling back to the
# VITE_ ones above if unset — but SUPABASE_SERVICE_ROLE_KEY has no client
# equivalent and MUST be set, server-only, never prefixed with VITE_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron (api/cleanup-old-videos.js) auth secret — optional but
# recommended so only Vercel's own cron trigger can call it.
CRON_SECRET=

# Gemini (used by Pro Deep Scan, 3-frame analysis, video analysis, Coach Chat):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
VITE_AI_PROVIDER=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
